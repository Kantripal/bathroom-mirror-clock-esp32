(version 1.1)
# Von platine.py erzeugt. Profil aisler-enig. Nicht von Hand aendern, wird beim Bauen und Pruefen neu geschrieben.
(rule "Fertigung: Bahnbreite mindestens 0.125mm"
    (constraint track_width (min 0.125mm)))
(rule "Fertigung: Abstand Kupfer mindestens 0.125mm"
    (constraint clearance (min 0.125mm)))
(rule "Fertigung: Kupfer zum Rand mindestens 0.3mm"
    (constraint edge_clearance (min 0.3mm)))
(rule "Fertigung: Bauteilbohrung 0.5mm bis 5.6mm"
    (constraint hole_size (min 0.5mm) (max 5.6mm))
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))
(rule "Fertigung: Restring Bauteilbohrung mindestens 0.3mm"
    (constraint annular_width (min 0.3mm))
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))
(rule "Fertigung: Via-Bohrung 0.25mm bis 0.45mm"
    (constraint hole_size (min 0.25mm) (max 0.45mm))
    (condition "A.Type == 'Via'"))
(rule "Fertigung: Restring Via mindestens 0.1mm"
    (constraint annular_width (min 0.1mm))
    (condition "A.Type == 'Via'"))
(rule "Fertigung: Bohrung zu Bohrung mindestens 0.3mm"
    (constraint hole_to_hole (min 0.3mm)))
(rule "Fertigung: Kupfer zu ungalvanisierter Bohrung mindestens 0.25mm"
    (constraint hole_clearance (min 0.25mm))
    (condition "B.Pad_Type == 'NPTH, mechanical'"))

# --- Herkunft: AislerHQ/aisler-support, kicad/aisler-2-layer-simple-drc (Mai 2024) ---
(rule "Max Drill Hole Size PTH"
    (constraint hole_size (max 5.6mm))
    (condition "A.Pad_Type == 'Through-hole'"))

(rule "Disallow buried via"
   (constraint disallow buried_via))

(rule "Disallow micro via"
   (constraint disallow micro_via))

(rule "Disallow solder mask margin overrides"
    (constraint assertion "A.Soldermask_Margin_Override == 0mm || A.Soldermask_Margin_Override == null")
    (condition "A.Type == 'Pad'"))
# --- Ende Aisler ---
